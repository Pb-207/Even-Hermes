# Dev-only build-time fallbacks (Vite-prefixed). These prefill the on-phone
# setup form during local development. Saved values in glasses storage always
# win over these. Copy to `.env.local` (gitignored) and fill in your own hosts.
#
# In production you configure everything from the phone setup screen — none of
# these are required to ship the app.

# Hermes agent gateway — an OpenAI-compatible API server (/v1/responses, Bearer auth).
# Bind it to 0.0.0.0 so the glasses/phone can reach it over your LAN.
VITE_HERMES_BASE_URL=http://your-hermes-host:8642
VITE_HERMES_API_KEY=
VITE_HERMES_MODEL=hermes-agent

# Speech-to-text — any OpenAI-compatible /v1/audio/transcriptions endpoint
# (faster-whisper-server, OpenAI cloud, Groq, etc.).
VITE_STT_BASE_URL=http://your-stt-host:8000
VITE_STT_API_KEY=
VITE_STT_MODEL=whisper-1
